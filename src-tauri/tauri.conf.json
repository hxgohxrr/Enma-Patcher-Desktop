{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enma Patcher Desktop",
  "version": "0.1.0",
  "identifier": "com.enmapatcher.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Enma Patcher Desktop",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#222b3a"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/hxgohxrr/Enma-Patcher-Desktop/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3RUNGOUE5MTZFQ0E3RkQKUldUOXArd1dxZm5zaDlPeGNhVzc4TWRQZkVJOGUzZkxnRjhQWmxJQ2lXWTdscWUvaE10RWR3aFoK"
    }
  }
}
